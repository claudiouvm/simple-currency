    /usr/bin/osascript -e 'on run argv' \
        -e 'tell application id "com.runningwithcrayons.Alfred" to search (item 1 of argv)' \
        -e 'end run' "$QUERY" &gt;/dev/null 2&gt;&amp;1
    exit 0
fi
